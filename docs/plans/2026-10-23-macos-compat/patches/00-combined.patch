+  watchdog_pid=$!
+  wait "$cmd_pid" 2>/dev/null || rc=$?
+  kill "$watchdog_pid" 2>/dev/null || true
+  if wait "$watchdog_pid" 2>/dev/null; then
+    rc=124
+  fi
+  return "$rc"
