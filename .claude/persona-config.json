{
  "testAndLintCommand": "bash tests/validate.sh",
  "graphUpdateCommand": "code-review-graph update --skip-flows",
  "sourceGlobs": [],
  "protectedPaths": [
    {
      "pattern": ".github/workflows/*",
      "tag": "server-mirror-eligible",
      "reason": "Workflows change rarely; CI rulesets depend on this path"
    },
    {
      "pattern": ".claude/constitution.md",
      "tag": "server-mirror-eligible",
      "reason": "Constitution is stable policy document; candidates for server freeze"
    },
    {
      "pattern": "hooks/scripts/protected-paths.sh",
      "tag": "local-only",
      "reason": "Gate itself; protected to prevent bypassing the protection mechanism"
    },
    {
      "pattern": "hooks/scripts/lib/benign-command.sh",
      "tag": "local-only",
      "reason": "Shared lexer library used by textual enforcement gates (reviewed-path-gate, human-decision-gate)"
    },
    {
      "pattern": "hooks/scripts/graph-update.sh",
      "tag": "local-only",
      "reason": "Graph update hook; graph state is development-time artifact"
    },
    {
      "pattern": "hooks/scripts/lint-on-edit.sh",
      "tag": "local-only",
      "reason": "Reporter hook; lint rules are development-time enforcement"
    },
    {
      "pattern": "hooks/scripts/marker-commit-check.sh",
      "tag": "local-only",
      "reason": "Hook for marker commit validation; affects local verdict workflow"
    },
    {
      "pattern": "hooks/scripts/heavy-trigger.sh",
      "tag": "local-only",
      "reason": "Utility hook; no cross-session contract"
    },
    {
      "pattern": "hooks/scripts/reviewer-tier.sh",
      "tag": "local-only",
      "reason": "Utility script setting reviewer tier based on paths; affects local review logic"
    },
    {
      "pattern": "hooks/scripts/session-start.sh",
      "tag": "local-only",
      "reason": "Session startup hook; exempt reporter, edited as other hooks change"
    },
    {
      "pattern": "hooks/scripts/lib/agent-identity.sh",
      "tag": "local-only",
      "reason": "Shared library for agent identity tagging; used by gate scripts"
    },
    {
      "pattern": "hooks/scripts/lib/graph-update-core.sh",
      "tag": "local-only",
      "reason": "Shared core for graph update hook"
    },
    {
      "pattern": "hooks/scripts/lib/lint-on-edit-core.sh",
      "tag": "local-only",
      "reason": "Shared core for lint-on-edit hook"
    },
    {
      "pattern": "hooks/scripts/lib/microworld-rerun-core.sh",
      "tag": "local-only",
      "reason": "Shared core for microworld rerun hook"
    },
    {
      "pattern": "hooks/scripts/lib/microworld-queue.sh",
      "tag": "local-only",
      "reason": "Queue management for async microworld rerun; critical for Unit A async mechanism"
    },
    {
      "pattern": "hooks/scripts/lib/protected-paths-core.sh",
      "tag": "local-only",
      "reason": "Shared core for protected-paths gate; hand-edited source for mirrors"
    },
    {
      "pattern": "hooks/scripts/lib/stop-gate-core.sh",
      "tag": "local-only",
      "reason": "Shared core for stop gate; coordinates with multiple hooks"
    },
    {
      "pattern": "hooks/scripts/lib/reviewer-route-gate-core.sh",
      "tag": "local-only",
      "reason": "Shared core for reviewer routing gate"
    }
  ],
  "gatedAgents": [
    "lead-programmer"
  ],
  "pluginVersion": "0.31.65",
  "personaSelection": [
    "spec-master",
    "task-master",
    "scribe",
    "reviewer",
    "milestone-auditor",
    "agent-auditor",
    "researcher"
  ],
  "issueTracker": "GitHub issues (repo: Storreslara/AntiSlop, gh CLI authenticated). File with 'gh issue create'; fetch with 'gh issue list --label plan/<slug>'. Triage label: to-tickets' own default (ready-for-agent) applies, no custom vocabulary configured.",
  "dispatchHygiene": {
    "mode": "warn",
    "maxPromptBytes": 30000,
    "maxInlineBlockLines": 80
  },
  "markerCommitCheck": {
    "mode": "warn"
  },
  "substitutions": {
    "graphMcpLaunch": {
      "command": "/home/sebas/.local/share/pipx/venvs/code-review-graph/bin/python",
      "args": [
        "-m",
        "code_review_graph",
        "serve"
      ]
    },
    "arxivMcpLaunch": {
      "command": "uvx",
      "args": [
        "arxiv-mcp-server"
      ]
    }
  },
