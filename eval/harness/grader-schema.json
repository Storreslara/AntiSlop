{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "identified": { "type": "boolean" },
          "evidence": { "type": "string" }
        },
        "required": ["id", "identified", "evidence"]
      }
    },
    "extra_fail_grounds": { "type": "integer" }
  },
  "required": ["defects", "extra_fail_grounds"]
}
